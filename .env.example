# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Todas as variáveis abaixo são PÚBLICAS (vão para o navegador). Nunca coloque
# tokens de bancos, senhas ou segredos em variáveis NEXT_PUBLIC_*.

# URL pública do site (usada em SEO, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ---------------------------------------------------------------- PIX
# Chave PIX de recebimento: CPF, CNPJ, e-mail, telefone (+5531999999999) ou chave aleatória
NEXT_PUBLIC_PIX_KEY=
# Nome do recebedor exatamente como no banco (até 25 caracteres, sem acento)
NEXT_PUBLIC_PIX_MERCHANT_NAME=
# Cidade do recebedor (até 15 caracteres)
NEXT_PUBLIC_PIX_MERCHANT_CITY=Belo Horizonte
# Identificador opcional (até 25 letras/números). Deixe vazio para "***"
NEXT_PUBLIC_PIX_TXID=
# Mude para true SOMENTE após fazer um PIX de teste e confirmar o recebimento
NEXT_PUBLIC_PIX_VALIDATED=false

# ---------------------------------------------------------------- WhatsApp
# Formato: 55 + DDD + número, só dígitos
NEXT_PUBLIC_WHATSAPP_NUMBER=553125553273
# Número validado pela equipe em 09/11/2026: links ativos por padrão.
# Use false apenas para desativar os botões de WhatsApp.
NEXT_PUBLIC_WHATSAPP_VALIDATED=true

# ---------------------------------------------------------------- Meta Pixel
# ID numérico do pixel (deixe vazio para desativar)
NEXT_PUBLIC_META_PIXEL_ID=
# true (padrão): o pixel só carrega após o visitante aceitar o aviso de privacidade
NEXT_PUBLIC_META_PIXEL_REQUIRE_CONSENT=true
